# ===========================================
# WaCRM - Environment Variables
# Copy this file to .env and fill in your values
# ===========================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/wacrm

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# ===========================================
# META WHATSAPP CLOUD API (Get from Meta Developer Dashboard)
# ===========================================
META_API_VERSION=v21.0
META_ACCESS_TOKEN=YOUR_PERMANENT_ACCESS_TOKEN_HERE
META_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID_HERE
META_BUSINESS_ACCOUNT_ID=YOUR_BUSINESS_ACCOUNT_ID_HERE
META_APP_SECRET=YOUR_APP_SECRET_HERE

# Webhook
WEBHOOK_VERIFY_TOKEN=my_wacrm_webhook_secret_123

# Redis (for Bull Queue - Campaign processing)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
